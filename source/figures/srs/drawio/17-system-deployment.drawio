cingLeft=10;" vertex="1" parent="1"><mxGeometry x="590" y="800" width="700" height="330" as="geometry" /></mxCell><mxCell id="d17_db" value="«database»&#10;MySQL" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="800" y="900" width="280" height="90" as="geometry" /></mxCell><mxCell id="d17_external_group" value="外部服务层" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=none;strokeWidth=1.0;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1390" y="90" width="740" height="720" as="geometry" /></mxCell><mxCell id="d17_ext_ai" value="AI 服务" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="1470" y="190" width="250" height="70" as="geometry" /></mxCell><mxCell id="d17_ext_image" value="图片识别" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="1760" y="190" width="250" height="70" as="geometry" /></mxCell><mxCell id="d17_ext_voice" value="语音识别" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="1470" y="340" width="250" height="70" as="geometry" /></mxCell><mxCell id="d17_ext_nav" value="地图服务" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="1760" y="340" width="250" height="70" as="geometry" /></mxCell><mxCell id="d17_ext_storage" value="对象存储" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="1615" y="500" width="250" height="70" as="geometry" /></mxCell><mxCell id="d17_test" value="«test»&#10;Mock / Stub" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1615" y="650" width="250" height="70" as="geometry" /></mxCell><mxCell id="d17_https" edge="1" parent="1" source="d17_frontend" target="d17_backend" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.0;fontSize=12;" value="HTTPS / REST"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d17_jdbc" edge="1" parent="1" source="d17_business" target="d17_db" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.0;fontSize=12;" value="JDBC"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d17_ext_link" edge="1" parent="1" source="d17_adapter" target="d17_external_group" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=1.0;fontSize=12;" value="受控接口"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d17_test_link" edge="1" parent="1" source="d17_test" target="d17_adapter" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;dashed=1;endArrow=none;startArrow=none;strokeWidth=1.0;" value="自动化测试"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d17_note1" value="前端不直接连接数据库或持有外部服务密钥&#10;所有核心业务写操作通过后端完成" style="shape=note;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="410" height="100" as="geometry" /></mxCell><mxCell id="d17_note2" value="订单、库存、资产和配送状态由各自业务服务统一维护&#10;页面不得绕过业务服务直接改变状态" style="shape=note;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="410" height="115" as="geometry" /></mxCell><mxCell id="d17_note3" value="外部 AI、图片识别、语音识别、地图或对象存储不可用时&#10;普通登录、搜索、购物车、订单、文本地址和状态管理仍应可用" style="shape=note;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="1390" y="870" width="740" height="115" as="geometry" /></mxCell><mxCell id="d17_note4" value="订单创建、库存预占、优惠券锁定和资产处理采用事务或可恢复一致性方案&#10;关键写操作通过业务唯一键、条件更新或版本号防止重复副作用&#10;核心变更保留原状态、新状态、执行者、时间和原因" style="shape=note;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.0;" vertex="1" parent="1"><mxGeometry x="1390" y="1030" width="740" height="170" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>