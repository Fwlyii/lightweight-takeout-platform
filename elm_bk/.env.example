DB_URL=jdbc:mysql://localhost:3306/elm_v2
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=replace-with-at-least-64-random-bytes

# Text chat. When empty, the application uses the local rule-based fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional local multimodal test profile: ai-mock
SPRING_PROFILES_ACTIVE=

# Image recognition and speech transcription through Alibaba Cloud Model Studio.
DASHSCOPE_API_KEY=
# Example: https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
DASHSCOPE_VISION_MODEL=qwen-vl-plus
DASHSCOPE_SPEECH_MODEL=qwen3-asr-flash
